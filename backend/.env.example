NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/flashkart
DB_POOL_SIZE=20
# Run pending migrations at boot (dev convenience; run them as a deploy step in prod)
RUN_MIGRATIONS_ON_BOOT=true

REDIS_URL=redis://localhost:6379

RESERVATION_TTL_SECONDS=300
RESERVATION_GRACE_SECONDS=60
CHECKOUT_WINDOW_SECONDS=60
SWEEPER_INTERVAL_MS=5000
RATE_LIMIT_PER_SECOND=10
